# =========================================================================
# FondosEG — Variables de entorno
# -------------------------------------------------------------------------
# Copia este archivo a `.env` (o `.env.local`) y rellena los valores.
#
#   VALORES OBLIGATORIOS  → la app no arranca sin ellos
#   SECRETS SERVER-ONLY   → nunca con prefijo NEXT_PUBLIC_, van al secret manager
#   OPCIONALES            → integraciones desactivadas si no se rellenan
#
# Genera secretos aleatorios con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# =========================================================================

# ---------------------------------------------------------------------------
# PUBLIC APPLICATION CONFIG — obligatorio, se compila al build
# ---------------------------------------------------------------------------

# URL base de la app. En dev usa http://localhost:3001 (ver scripts/dev-next.cjs).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Proyecto Supabase. En local puedes usar la URL de `supabase start`.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Anon key pública de Supabase. NO es un secreto: se expone al navegador.
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-key

# ---------------------------------------------------------------------------
# CLERK — proveedor de identidad (obligatorio)
# ---------------------------------------------------------------------------
# Ambas claves se copian del dashboard de Clerk (o las escribe `clerk init`).
# https://dashboard.clerk.com/apps/<tu-app>/keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace-me
CLERK_SECRET_KEY=sk_test_replace-in-secret-manager
# Firma de Svix del webhook Clerk (Dashboard → Webhooks → Endpoint → Signing Secret).
# Sólo se necesita si se habilita el endpoint /api/webhooks/clerk.
# CLERK_WEBHOOK_SIGNING_SECRET=whsec_replace-me

# Rutas de las pantallas de acceso propias de la aplicación.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/register

# Redirección tras iniciar/cerrar sesión.
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# Sólo en producción con dominio propio (p. ej. clerk.fondoseg.com).
# next.config.ts lo añade a la CSP; sin él, el script de Clerk se bloquea.
# Formato: https://clerk.tu-dominio.com  (opcional)
# NEXT_PUBLIC_CLERK_FRONTEND_API_URL=https://clerk.tu-dominio.com

# ---------------------------------------------------------------------------
# SERVER-ONLY SECRETS (nunca con prefijo NEXT_PUBLIC_)
# ---------------------------------------------------------------------------
# Van únicamente en el entorno del servidor (Vercel env vars, secret manager,
# .env.local en dev). Si alguno falta, la función correspondiente falla o se
# degrada: el arranque no crashea.

# Service-role key de Supabase — ACCESO TOTAL a la base de datos.
# Solo el servidor puede usarla. NUNCA la expongas al cliente.
# https://supabase.com/dashboard/project/<tu-proyecto>/settings/api
SUPABASE_SERVICE_ROLE_KEY=replace-in-secret-manager

# Sal para el rate-limit de la API pública. MÍNIMO 32 bytes aleatorios.
# Usa: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PUBLIC_RATE_LIMIT_SALT=generate-at-least-32-random-bytes

# Cifra los secretos de webhook en reposo (AES-256-GCM). MÍNIMO 32 bytes.
WEBHOOK_ENCRYPTION_KEY=generate-at-least-32-random-bytes

# Autoriza los workers internos (Bearer <secretado>):
#   POST /api/webhooks/process      → drena webhook_deliveries
#   POST /api/support/email-sync    → sincroniza el buzón IMAP
WEBHOOK_WORKER_SECRET=generate-at-least-32-random-bytes
SUPPORT_EMAIL_SYNC_SECRET=generate-at-least-32-random-bytes

# Proveedor de pagos genérico (alquileres) — opcional. Sin esto los endpoints
# de rental-payments devuelven 503 SERVICE_UNAVAILABLE.
PAYMENTS_PROVIDER_WEBHOOK_SECRET=replace-in-secret-manager
PAYMENTS_PROVIDER_API_SECRET=replace-in-secret-manager

# ---------------------------------------------------------------------------
# INTEGRACIONES OPCIONALES — océano de funcionalidad extra
# ---------------------------------------------------------------------------

# Twilio — envío de SMS (outbox de notificaciones).
# Sin auth token, las notificaciones SMS se quedan en la cola sin enviar.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=replace-in-secret-manager
TWILIO_PHONE_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=
# Alphanumeric Sender ID (e.g. "FondosEG") usado en send_sms.js cuando el
# "from" no es un número E.164.
TWILIO_ALPHANUMERIC_SENDER_ID=
# API key/secret (quickstart): creadas en twilio.com/console/runtime/api-keys.
TWILIO_API_KEY=
TWILIO_API_SECRET=

# Resend — correo transaccional (OTP, bienvenida, soporte).
# Verifica el dominio en https://resend.com/domains antes de enviar correo real.
RESEND_API_KEY=replace-in-secret-manager
RESEND_FROM_EMAIL=FondosEG <no-reply@fondoseg.com>

# Revolut — Payout Links (pagos a beneficiarios).
# Requiere JWKS generado con scripts/generate-revolut-jwks.js.
REVOLUT_ENV=sandbox
REVOLUT_CLIENT_ID=
REVOLUT_PRIVATE_KEY=
REVOLUT_ACCOUNT_ID=
REVOLUT_ACCESS_TOKEN=
REVOLUT_REFRESH_TOKEN=
REVOLUT_API_BASE_URL=https://sandbox-oba.revolut.com
REVOLUT_REDIRECT_DOMAIN=
REVOLUT_PAYOUT_METHODS=funds
REVOLUT_PAYOUT_EXPIRY_PERIOD=72h

# Proveedor de pagos (alquileres)
PAYMENTS_PROVIDER_NAME=
PAYMENTS_PROVIDER_BASE_URL=
PAYMENTS_PROVIDER_API_KEY=

# Buzón de soporte (IMAP) — sincronizado por /api/support/email-sync
SUPPORT_EMAIL=
SUPPORT_EMAIL_IMAP_HOST=
SUPPORT_EMAIL_IMAP_PORT=993
SUPPORT_EMAIL_IMAP_MAILBOX=INBOX
SUPPORT_EMAIL_MARK_SEEN=true
# Public application configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-key

# Clerk — proveedor de identidad
# Las dos claves se copian del dashboard de Clerk (o las escribe `clerk init`).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace-me
CLERK_SECRET_KEY=sk_test_replace-in-secret-manager

# Rutas de las pantallas de acceso propias de la aplicación.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/register
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# Sólo en producción con dominio propio (p. ej. clerk.fondoseg.com).
# next.config.ts lo añade a la CSP; sin él, el script de Clerk se bloquea.
# NEXT_PUBLIC_CLERK_FRONTEND_API_URL=https://clerk.tu-dominio.com

# Server-only secrets (never prefix these with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=replace-in-secret-manager
PUBLIC_RATE_LIMIT_SALT=generate-at-least-32-random-bytes
WEBHOOK_WORKER_SECRET=generate-at-least-32-random-bytes
PAYMENTS_PROVIDER_WEBHOOK_SECRET=replace-in-secret-manager
PAYMENTS_PROVIDER_API_SECRET=replace-in-secret-manager
TWILIO_AUTH_TOKEN=replace-in-secret-manager
RESEND_API_KEY=replace-in-secret-manager

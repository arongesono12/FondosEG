# =========================================================================
# npm como gestor de paquetes canónico
# -------------------------------------------------------------------------
# El repo usaba npm y bun en paralelo. Se consolida en npm: el lockfile de
# referencia es package-lock.json. Bun sigue funcionando, pero no se añaden
# dependencias con él.
# =========================================================================
# engine-strict evita instalar en versiones de Node incompatibles.
engine-strict=true

# Evita publicar accidentalmente el proyecto a npm registry.
private=true

# Instalaciones silenciosas por defecto en CI.
fund=false
audit=true